# --- Database ---
DATABASE_URL=postgresql+psycopg2://arena:arena@localhost:5432/probability_arena

# --- Redis (candidate-list caching; app degrades gracefully if unreachable) ---
REDIS_URL=redis://localhost:6379/0
CANDIDATES_CACHE_TTL_SECONDS=30

# --- Kalshi REST (public market data needs no credentials) ---
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_REQUEST_TIMEOUT_SECONDS=10
# Server-side exclusion of auto-generated multivariate/parlay markets
# ("exclude" recommended; set empty to fetch them too)
KALSHI_MVE_FILTER=exclude

# --- Kalshi WebSocket snapshots (OPTIONAL — service only starts if BOTH are set) ---
# API key id from https://kalshi.com account settings
KALSHI_API_KEY_ID=
# Path to the RSA private key PEM downloaded when the API key was created
KALSHI_PRIVATE_KEY_PATH=
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2
# Comma-separated market tickers to subscribe to; empty = top candidates from last scan
KALSHI_WS_TICKERS=

# --- Scanner / ranking ---
SCANNER_MAX_MARKETS=500
CANDIDATES_DEFAULT_LIMIT=25

# --- Targeted game-level market scans (SCANNER-002/OPS-010) ---
# Read-only supplement: fetch supported measurable series (winner/total/spread)
# by series_ticker so props can't crowd them out of the first generic page.
# Scanner coverage only — no EV, no advice, no trading capability of any kind.
ENABLE_TARGETED_MARKET_SCANS=true
TARGETED_MARKET_SERIES=KXWCGAME,KXWCTOTAL,KXWCSPREAD,KXMLBGAME,KXMLBTOTAL,KXMLBSPREAD
TARGETED_MARKET_SCAN_LIMIT_PER_SERIES=250
TARGETED_MARKET_SCAN_ACTIVE_ONLY=true
TARGETED_MARKET_SCAN_DEDUP=true
# Watcher supported-universe supplement bound (game-level baseball/soccer only)
WATCHER_SUPPORTED_UNIVERSE_LIMIT=50

# --- Resolution-criteria assessment ---
# LLM judgment is OFF by default; the deterministic rule-based judge always works.
# Enabling requires the `anthropic` package and an Anthropic credential
# (ANTHROPIC_API_KEY, or an `ant auth login` profile).
ENABLE_LLM_RESOLUTION=false
RESOLUTION_MODEL_NAME=claude-opus-4-8
RESOLUTION_PROMPT_VERSION=v1
# Candidates scoring below this are marked needs_manual_review/avoid
MIN_CLARITY_SCORE=0.70

# --- Research packet collection ---
# External (LLM + web search) research is OFF by default; the deterministic
# template collector always works and never touches the web.
ENABLE_EXTERNAL_RESEARCH=false
RESEARCH_COLLECTOR_NAME=template
RESEARCH_COLLECTOR_VERSION=v1
RESEARCH_MODEL_NAME=claude-opus-4-8

# --- Baseball external research canary ---
# Narrow canary, NOT global external research: applies only to PROMOTED
# signals whose domain is sports_baseball with a researchable resolution.
# Evidence comes from the public MLB Stats API (read-only GETs, no key).
ENABLE_BASEBALL_EXTERNAL_RESEARCH=false
BASEBALL_RESEARCH_TIMEOUT_SECONDS=15
BASEBALL_RESEARCH_MAX_SOURCES=8
BASEBALL_RESEARCH_COLLECTOR_VERSION=v1

# --- Soccer / World Cup external research canary ---
# Narrow canary, NOT global external research: applies only to PROMOTED
# signals whose domain is sports_soccer with a researchable resolution.
# SOCCER_RESEARCH_PROVIDER selects the live data source: "template" keeps the
# collector fallback-only (honest template packets) even when the flag is on;
# "espn" enables the public ESPN soccer API (read-only GETs, no key).
ENABLE_SOCCER_EXTERNAL_RESEARCH=false
SOCCER_RESEARCH_PROVIDER=template
SOCCER_RESEARCH_TIMEOUT_SECONDS=15
SOCCER_RESEARCH_MAX_SOURCES=8
SOCCER_RESEARCH_COLLECTOR_VERSION=v1

# --- Baseball evidence-aware forecasting canary ---
# Consumes source-backed MLB research packets (no external calls itself) and
# produces capped, explainable, non-midpoint forecasts for recognized market
# types (totals / spreads / game winner). Everything else stays on the
# template baseline.
ENABLE_BASEBALL_EVIDENCE_FORECASTING=false
BASEBALL_FORECASTER_VERSION=v1
BASEBALL_FORECAST_MAX_CONFIDENCE=0.70
BASEBALL_FORECAST_MIN_COMPLETENESS=0.75

# --- MarketOps Autopilot (OPS-006) ---
# Read-only 24/7 coordination of existing services: auto-promote/process
# signals, crypto scan, outcome sync, scoring, champion/challenger snapshot,
# local DB alerts. It CANNOT trade, paper trade, calculate EV, or move money.
# The flag gates only the loop/timer; marketops-run-once is always allowed.
ENABLE_MARKETOPS_AUTOPILOT=false
MARKETOPS_PROMOTE_LIMIT=5
MARKETOPS_PROCESS_LIMIT=5
MARKETOPS_CRYPTO_SCAN_LIMIT=100
MARKETOPS_SYNC_OUTCOME_LIMIT=500
MARKETOPS_SCORE_LIMIT=1000
MARKETOPS_MIN_SIGNAL_AGE_SECONDS=30
MARKETOPS_MAX_SIGNAL_AGE_HOURS=24
MARKETOPS_INCLUDE_CRYPTO=true
MARKETOPS_INCLUDE_PROBABILITY_MARKETS=true
MARKETOPS_FAIL_FAST=false
MARKETOPS_LOOP_INTERVAL_SECONDS=300

# --- Crypto Arena scout (CRYPTO-001) ---
# Read-only Solana memecoin surveillance: DEX Screener discovery, price/
# liquidity ticks, deterministic informational risk signals. NO wallets, NO
# private keys, NO swaps, NO Jupiter/transaction construction, NO signing,
# NO execution, NO EV, NO paper trading (docs/SAFETY_BOUNDARIES.md).
# ENABLE_CRYPTO_SCOUT reserves loop/timer use (none exists in CRYPTO-001);
# manual `crypto-scan-once` runs are always allowed.
ENABLE_CRYPTO_SCOUT=false
# CRYPTO-COVERAGE-REPAIR-001: gates the scheduled provider-free survival
# reconciler (systemd timer, every 6h). Zero external calls. Default off.
ENABLE_CRYPTO_TAPE_RECONCILER=false
# Steady-state lookback window for one reconciliation pass. Must exceed the
# longest horizon's closing edge (24h * 1.5 = 36h) plus one scheduling
# interval (6h), or the pass refuses (status=invalid_window).
CRYPTO_TAPE_RECONCILER_WINDOW_HOURS=48
# MEDIUM fix (second re-review, convergence lens): must exceed IN-WINDOW
# ELIGIBLE tokens PLUS the intended backlog budget, not merely "cover the
# whole window" — a limit that is merely >= in-window eligible still starves
# the aged-out backlog of ANY budget (status=partial, backlog_processed=0,
# permanently, not just for one pass: see CRYPTO-COVERAGE-REPAIR-001's
# NEW-BLOCKING-1 finding). LOWERING this in response to write-contention
# warnings is exactly the change that re-opens that trap — raise batch_size
# or lower max_duration_seconds instead if write pressure is the concern.
# A binding limit reports status=partial (not status=truncated) whenever it
# is ALSO deadline/contention-stopped — which is the common case at
# production density — with the truncation-specific detail appended to the
# same error string, not a separate status.
CRYPTO_TAPE_RECONCILER_LIMIT=2000
# Tokens committed per write transaction. Bounds how long the pass holds
# SQLite's write lock at a time (see docs/EVO_X2_RUNBOOK.md for the measured
# hold-duration-vs-competing-writer-wait distinction — this does NOT bound a
# competing writer's worst-case wait, which tracks the deadline below).
# COUNT-based, not time-based: the 20s deadline cannot bound a single
# batch's hold (only evaluated BETWEEN batches), so the actual hold scales
# with (this value x per-token cost on THIS host) — a value measured safe
# on one host is not portable to a slower one (CRYPTO-COVERAGE-REPAIR-001
# NEW-HIGH-1, DO NOT ACTIVATE finding: 25 produced 26.3-36.5s holds at
# EVO-measured host speed, one trial exceeding the 30s busy_timeout, and
# could not converge against the birth rate). PRE-ACTIVATION STEP: measure
# a real batch's hold on the TARGET host
# (`crypto-tape-reconcile --batch-size N --dry-run`) and set this so the
# hold stays comfortably under the busy_timeout — never trust this default
# on an unmeasured host.
CRYPTO_TAPE_RECONCILER_BATCH_SIZE=5
# Internal wall-clock deadline for one pass; the rest becomes next-pass
# backlog (status=partial, stop_reason=deadline) rather than running
# indefinitely. NOT yet re-measured end-to-end on EVO-X2 production density
# after the per-batch-commit change — see docs/milestones/
# CRYPTO-COVERAGE-REPAIR-001.md. Override with `crypto-tape-reconcile
# --max-duration-seconds N --dry-run` to measure a full, untruncated pass
# before trusting this default.
CRYPTO_TAPE_RECONCILER_MAX_DURATION_SECONDS=20.0
# CRYPTO-RECONCILER-LOCK-WAIT-BUDGET-001 — how long ONE reconciler lock
# ACQUISITION may WAIT (seconds). Not the same thing as how long a
# transaction may HOLD the lock (that is the write-time SLO / time budget
# below). Leave UNSET: the shipped behaviour derives the budget per attempt
# from the pass's own remaining deadline, so the reconciler can never wait
# past `CRYPTO_TAPE_RECONCILER_MAX_DURATION_SECONDS`. Set a positive value
# only as a tighter CAP, derived from the `lock_wait_ms` histogram this
# reconciler persists on every run row — never guessed.
# CRYPTO_TAPE_RECONCILER_LOCK_WAIT_BUDGET_SECONDS=
# The write-time SLO knobs for ADAPTIVE batching (the structural replacement
# for the count-based CRYPTO_TAPE_RECONCILER_BATCH_SIZE). Both must be set
# for adaptive batching to activate, and
# _INITIAL_PER_TOKEN_COST_SECONDS is deliberately UNCALIBRATED — it means
# nothing until someone has measured a real batch's write-phase wall time on
# the TARGET host (`crypto-tape-reconcile --batch-size N --dry-run`), which
# is why there is no default and both stay commented out here. Until they
# are set, the 2.0s write-hold SLO is RECORDED but not ENFORCED: every run
# row carries `write_hold_ms_max` / `write_hold_slo_violations`.
# CRYPTO_TAPE_RECONCILER_TIME_BUDGET_SECONDS=2.0
# CRYPTO_TAPE_RECONCILER_INITIAL_PER_TOKEN_COST_SECONDS=
CRYPTO_CHAIN=solana
CRYPTO_PROVIDER=dexscreener
CRYPTO_WATCHER_POLL_INTERVAL_SECONDS=60
CRYPTO_PAIR_LIMIT=100
CRYPTO_MIN_LIQUIDITY_USD=5000
CRYPTO_MIN_VOLUME_5M_USD=1000
CRYPTO_SIGNAL_COOLDOWN_SECONDS=900
# Reserved only — no Helius adapter exists in CRYPTO-001
ENABLE_HELIUS=false
# Optional risk provider; "mock" is the only CRYPTO-001 implementation
ENABLE_CRYPTO_RISK_PROVIDER=false
CRYPTO_RISK_PROVIDER=mock
# Prunes crypto_price_ticks + crypto_watcher_runs only
CRYPTO_RETENTION_DAYS=7

# --- Crypto risk engine (CRYPTO-002) ---
# Read-only risk INTELLIGENCE: heuristics + optional providers produce
# composite risk scores and avoid/flag verdicts for review. A risk score is
# NEVER a trade recommendation; "severe" means avoid/flag, not short/sell.
# API keys are optional, sent as request headers only, and never printed.
ENABLE_CRYPTO_RISK_ENGINE=false
ENABLE_GOPLUS_RISK=false
GOPLUS_API_KEY=
ENABLE_SOLANA_TRACKER_RISK=false
SOLANA_TRACKER_API_KEY=
# SolanaTracker Advanced request accounting + budget guardrails (PROVIDER-BUDGET-001).
# Cost/usage observability only (plan ~$58-59/month USD, 200k requests/month).
# Guardrails only SKIP optional SolanaTracker lookups when over budget (tokens
# fall back to GoPlus+heuristics, a supported mode); they never add calls, never
# touch GoPlus/Birdeye, and carry no EV/trade/sizing/order/wallet/signing/execution.
SOLANA_TRACKER_MONTHLY_REQUEST_LIMIT=200000
SOLANA_TRACKER_DAILY_REQUEST_BUDGET=5000
SOLANA_TRACKER_HOURLY_REQUEST_BUDGET=200
SOLANA_TRACKER_PER_RUN_LOOKUP_LIMIT=25
SOLANA_TRACKER_CACHE_TTL_HOURS=24
SOLANA_TRACKER_WARN_DAILY_REQUESTS=4000
SOLANA_TRACKER_STOP_DAILY_REQUESTS=6000
# Reserved only — no RugCheck adapter exists in CRYPTO-002
ENABLE_RUGCHECK_RISK=false
CRYPTO_RISK_MIN_LIQUIDITY_USD=5000
CRYPTO_RISK_MAX_TOP_HOLDER_PCT=20
CRYPTO_RISK_MAX_SNIPER_PCT=20
CRYPTO_RISK_MAX_INSIDER_PCT=15
CRYPTO_RISK_MAX_BUNDLER_PCT=25
CRYPTO_RISK_MIN_PAIR_AGE_SECONDS=300
CRYPTO_RISK_PROVIDER_TIMEOUT_SECONDS=10
CRYPTO_RISK_ENGINE_VERSION=v1

# --- Polymarket market-data observer (POLY-001) ---
# Read-only SECOND prediction-market venue: public/no-auth GETs against the
# Gamma market catalog + CLOB order books. Market-DATA observation only — NO
# EV, NO arbitrage, NO trade recommendation, NO sizing, NO order placement, NO
# wallets/private keys, NO signing, NO swaps, NO execution (docs/SAFETY_BOUNDARIES.md).
# ENABLE_POLYMARKET_SCOUT reserves loop/timer use (none installed in POLY-001);
# manual `polymarket-scan-once` + all reports are always allowed.
ENABLE_POLYMARKET_SCOUT=false
POLYMARKET_MARKET_LIMIT=50
POLYMARKET_ORDERBOOK_LIMIT=20
POLYMARKET_TIMEOUT_SECONDS=15
POLYMARKET_RETENTION_DAYS=14
POLYMARKET_PROVIDER_VERSION=v1

# --- Retention / pruning ---
# Prunes operational tables only (price ticks, watcher runs, pipeline audit).
# Intelligence/calibration tables (outcomes, forecasts, scores, packets,
# enrichments, assessments) are NEVER pruned.
TICK_RETENTION_DAYS=7
WATCHER_RUN_RETENTION_DAYS=30
PIPELINE_RUN_RETENTION_DAYS=90
# 0 = keep opportunity signals indefinitely
SIGNAL_RETENTION_DAYS=0
RETENTION_BATCH_SIZE=5000

# --- OPS-011 DB growth & alert calibration (advisory ops alerts; not trading) ---
DB_GROWTH_WARNING_MB=1536
DB_GROWTH_CRITICAL_MB=3072
DB_GROWTH_WARNING_DAILY_MB=1024   # observability/proposed rate
DB_GROWTH_WINDOW_HOURS=24         # observability/proposed rate window
MARKETOPS_SIGNAL_FLOOD_WARNING_PER_HOUR=400
MARKETOPS_SIGNAL_FLOOD_CRITICAL_PER_HOUR=800
# Run retention as a final baseline-pipeline stage (off by default)
ENABLE_PIPELINE_RETENTION=false
# Let the watcher loop prune at most once per day (off by default)
ENABLE_WATCHER_RETENTION=false

# --- Real-time opportunity watcher ---
# Signals are informational only: no EV, no sizing, no trade directives.
# The loop refuses to start unless ENABLE_REALTIME_WATCHER=true
# (watch-once always works for manual runs).
ENABLE_REALTIME_WATCHER=false
WATCHER_POLL_INTERVAL_SECONDS=60
WATCHER_MARKET_LIMIT=100
# Midpoint move (in dollars) that fires price_move_threshold
WATCHER_PRICE_MOVE_THRESHOLD=0.07
# spread_tightened fires when the spread crosses into <= this band (dollars)
WATCHER_MAX_SPREAD=0.15
# liquidity_appeared fires when liquidity proxy crosses >= this (cents)
WATCHER_MIN_LIQUIDITY_PROXY=100
# Same (ticker, signal_type) is deduped within this window
WATCHER_SIGNAL_COOLDOWN_SECONDS=900

# --- Baseline pipeline runner ---
# Scheduled read-only measurement loop (scan -> ... -> calibration-report).
# Overlapping runs are prevented by a DB lock; a second run exits as skipped.
BASELINE_SCAN_LIMIT=500
BASELINE_CANDIDATE_LIMIT=20
BASELINE_FAIL_FAST=false
BASELINE_SYNC_OUTCOME_LIMIT=200
BASELINE_SCORE_LIMIT=1000

# --- Forecast engine ---
# LLM forecasting is OFF by default; the deterministic template baseline
# always works. Forecasts are probabilities + reasoning only — no EV,
# no sizing, no trade recommendations.
ENABLE_LLM_FORECASTING=false
FORECASTER_NAME=template_baseline
FORECASTER_VERSION=v1
FORECAST_PROMPT_VERSION=v1
FORECAST_MODEL_NAME=claude-opus-4-8
# Deterministic confidence ceilings by evidence depth (enforced in post-
# processing regardless of what any forecaster reports)
TEMPLATE_ONLY_MAX_CONFIDENCE=0.55
SOURCE_BACKED_MAX_CONFIDENCE=0.75
MISSING_CRITICAL_INFO_MAX_CONFIDENCE=0.50

# --- Candidate hygiene / eligibility gating ---
# Markets failing any enabled gate are rejected (rejection_reasons recorded)
# and excluded from /markets/candidates unless include_rejected=true.
REQUIRE_TWO_SIDED_QUOTE=true
EXCLUDE_ZERO_QUOTE_MARKETS=true
MIN_LIQUIDITY=100
MIN_VOLUME_24H=25
# Max yes bid/ask spread in dollars (0.20 = 20 cents)
MAX_SPREAD=0.20
MIN_DAYS_TO_EXPIRATION=0.25
MAX_DAYS_TO_EXPIRATION=45

# --- Operational hardening (OPS-007) ---
# A 'running' marketops cycle older than this is treated as crashed
MARKETOPS_LOCK_STALE_AFTER_MINUTES=30
# SQLite connections wait this long for write locks (Postgres unaffected)
SQLITE_BUSY_TIMEOUT_MS=30000
# Compressed DB snapshots (backup-db / list-db-backups / verify-db-backup)
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=data/backups

# CRYPTO-COVERAGE-REPAIR-001 B10 — migration governance. "guarded" (the
# safe default, and the ONLY value ever set on a production/deploy host)
# makes ordinary runtime (all CLI commands, watch-loop, marketops-run-once,
# the FastAPI service) FAIL CLOSED with MIGRATION_REQUIRED when the
# database is behind the code's required Alembic revision, instead of
# auto-upgrading. "auto" restores always-upgrade-on-every-call, for local
# development/first-install convenience ONLY — set this deliberately, never
# inferred from a hostname or path. Deployment upgrades explicitly:
# `python -m app.cli sqlite-backup-freshness-report` (confirm a fresh
# backup) -> `alembic upgrade head` -> `python -m app.cli agent-context`
# (confirm alembic revision == head) -> restart/resume runtime.
MIGRATION_MODE=guarded

# --- Raw provider payload storage (RAW-PAYLOAD-STORAGE-001) ---
# Whether the FULL provider response body is persisted next to the normalized
# columns already extracted from it. Measured at ~1,583 MiB (about a third of
# the production database), ~95% of each row in the two largest tables.
#   full = store the complete body (DEFAULT; current behaviour)
#   none = never store the body; keep bounded provenance only
# Columns a production reader depends on are pinned to full regardless.
# An unrecognised value fails CLOSED to "full", never to "none".
# Suppression is PROSPECTIVE ONLY — no historical row is ever modified.
# NOTE: settings are @lru_cache'd, so a LONG-LIVED writer (the watcher service)
# keeps the mode it started with. Changing this value requires restarting
# probability-arena-watcher.service before market_price_ticks reflects it —
# in BOTH directions, activation and rollback.
RAW_PAYLOAD_CAPTURE_MODE=full

# --- SQLite backup freshness monitoring (SQLITE-BACKUP-FRESHNESS-ALERT-001) ---
# Default OFF. When true, an isolated, fail-contained MarketOps hook checks once
# per cycle that BACKUP_DIR still holds a recent, committed, structurally valid,
# manifest-backed backup, and drives ONE deduplicated backup_freshness_warning
# alert (resolved automatically when health returns). Local files only: zero
# provider calls, never runs a backup, never prunes, never modifies a backup or
# manifest, adds no timer/daemon, and cannot fail the cycle. The 36-hour
# staleness threshold is a code constant, not a setting.
# The read-only `sqlite-backup-freshness-report` CLI works regardless of this flag.
MARKETOPS_INCLUDE_BACKUP_FRESHNESS_ALERT=false

# --- Edge precheck (MVP-005A) ---
# Probability-gap MEASUREMENT only: forecast_probability - market_midpoint
# with validity checks. NOT dollar EV, NOT advice; paper_candidate_later is
# a review label with zero attached behavior. Thresholds are provisional
# (docs/MVP_005A_EDGE_PRECHECK_DESIGN.md section 6).
ENABLE_EDGE_PRECHECK=false
EDGE_PRECHECK_MIN_ABS_GAP=0.05
EDGE_PRECHECK_MAX_SPREAD_CENTS=10
EDGE_PRECHECK_MIN_LIQUIDITY_CENTS=500
EDGE_PRECHECK_MIN_CONFIDENCE=0.60
EDGE_PRECHECK_MAX_FORECAST_AGE_SECONDS=900
EDGE_PRECHECK_MAX_LIVE_SPORTS_FORECAST_AGE_SECONDS=300
EDGE_PRECHECK_MAX_MARKET_SNAPSHOT_AGE_SECONDS=120
EDGE_PRECHECK_REQUIRE_SOURCE_BACKED=true
EDGE_PRECHECK_REQUIRE_RESEARCHABLE=true
EDGE_PRECHECK_REQUIRED_PERSISTENCE_SNAPSHOTS=3
# MarketOps stage is DOUBLE-gated: this AND ENABLE_EDGE_PRECHECK
MARKETOPS_INCLUDE_EDGE_PRECHECK=false
# MVP-005A.1: targeted modes skip a forecast measured within this window;
# window/signal-based targeting selects source-backed forecasts only
EDGE_PRECHECK_DEDUPE_SECONDS=120
EDGE_PRECHECK_TARGET_ONLY_SOURCE_BACKED=true

# --- Soccer evidence-aware forecasting canary (SOCCER-002) ---
# Consumes source-backed soccer packets (no external calls itself); capped,
# explainable, non-midpoint forecasts for winner/advance/total/spread
# markets. Player-goal markets fall back (team data can't price a player).
# Forecasts are measurement inputs only — no EV, no trade semantics.
ENABLE_SOCCER_EVIDENCE_FORECASTING=false
SOCCER_FORECASTER_VERSION=v1
SOCCER_FORECAST_MAX_CONFIDENCE=0.70
SOCCER_FORECAST_MIN_COMPLETENESS=0.75

# --- OPS-009 promotion freshness (minute-level, domain-aware) ---
# Minutes supersede MARKETOPS_MAX_SIGNAL_AGE_HOURS (kept as coarse upper
# bound). Promotion ordering uses a measurement-readiness score — never an
# EV/value/trade quantity.
MARKETOPS_MAX_SIGNAL_AGE_MINUTES=60
MARKETOPS_LIVE_SPORTS_MAX_SIGNAL_AGE_MINUTES=20
MARKETOPS_SOCCER_MAX_SIGNAL_AGE_MINUTES=20
MARKETOPS_BASEBALL_MAX_SIGNAL_AGE_MINUTES=20
MARKETOPS_GENERAL_MAX_SIGNAL_AGE_MINUTES=60
# Reserved/unused in OPS-009
MARKETOPS_CRYPTO_SIGNAL_AGE_MINUTES=60
