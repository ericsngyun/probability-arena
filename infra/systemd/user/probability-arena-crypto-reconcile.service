# Probability Arena — CRYPTO-COVERAGE-REPAIR-001 provider-free reconciliation.
# Revisits already-persisted tokens whose survival horizons have matured so
# 6h/24h outcomes can populate from evidence already on disk. Reads and writes
# ONLY our own lifecycle/outcome rows. Zero external calls, zero provider
# budget, no discovery scan, no cohort, no arming, no wallets, no keys, no
# swaps, no signing, no orders, no execution of any kind.
# A complete no-op while ENABLE_CRYPTO_TAPE_RECONCILER is false (set in .env).
# NOT auto-installed. See the .timer file for install commands.

[Unit]
# Deliberately no After=network-online.target: this unit makes zero external
# calls, and declaring a network dependency would invite a future reader to
# believe otherwise.
Description=Probability Arena crypto survival reconciliation (provider-free)

[Service]
Type=oneshot
WorkingDirectory=%h/projects/probability-arena
EnvironmentFile=%h/projects/probability-arena/.env
ExecStart=%h/projects/probability-arena/.venv/bin/python -m app.cli crypto-tape-reconcile
NoNewPrivileges=true
# The pass commits in bounded batches (each individual write-lock hold is a
# small fraction of a second, not the whole pass — see crypto_tape.py's
# RECONCILE_BATCH_SIZE comment), but this is a SQLite writer on a host with a
# 5-minute MarketOps timer, a continuously-writing watcher, and a documented
# lock-contention history, and a competing writer's worst-case WAIT still
# tracks this pass's WALL TIME, not the per-batch hold (measured: SQLite's
# busy handler loses the lock race against ~80 back-to-back short write
# transactions almost as easily as against one long one — see NEW-H2 in
# crypto_tape.py and app/config.py). Yield CPU and IO so reconciliation never
# wins a scheduling contest against the live lanes.
Nice=10
CPUWeight=20
IOWeight=20
# NOT a licence to run long. The scheduled pass stops at an internal
# wall-clock deadline (default 20s = crypto_tape_reconciler_max_duration_seconds)
# plus at most one in-flight batch; that combined figure — NOT the per-batch
# write-lock hold — is the honest bound on how long a competing writer can be
# blocked, and at the shipped default it is >=67% of the 30s busy_timeout.
# MEDIUM fix (third re-review, M2): `run_scheduled_reconciliation` never
# overrides `max_lock_attempts`/`lock_retry_seconds`, so DB_LOCKED_MAX_ATTEMPTS
# (3) / DB_LOCKED_RETRY_SECONDS (3.0s) apply, and the deadline is only
# checked BETWEEN batches, not during one — a single in-flight batch's own
# retry ladder can consume up to 3 x sqlite_busy_timeout_ms (30s) + 2 x 3s =
# ~96s before giving up, and the SEPARATE finalize-commit retry ladder can
# add another ~96s worst case on top of the 20s deadline. Honest worst-case
# bound: ~20s (deadline) + ~96s (one in-flight batch) + ~96s (finalize) =
# ~212s (~3.5min), not the "10 minutes" this value previously stated with no
# derivation. TimeoutStartSec is tightened to comfortably (not tightly)
# exceed that computed bound, rather than SIGKILLing a legitimate in-flight
# retry ladder mid-write.
TimeoutStartSec=5min

[Install]
WantedBy=default.target
