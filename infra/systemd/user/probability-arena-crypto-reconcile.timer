# Probability Arena — CRYPTO-COVERAGE-REPAIR-001 provider-free reconciliation
# timer (USER unit). NOT auto-installed. Install:
#   cp infra/systemd/user/probability-arena-crypto-reconcile.{service,timer} \
#      ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now probability-arena-crypto-reconcile.timer
# Inspect:
#   systemctl --user list-timers | grep crypto-reconcile
#   journalctl --user -u probability-arena-crypto-reconcile.service -n 50 --no-pager
#
# Cadence rationale: survival horizons close at 24h * (1 + HORIZON_TOLERANCE)
# = 36h after birth, and the ticks that mature them are pruned after
# crypto_retention_days (7d). Every 6h means any maturing horizon is
# reconciled within at most 6h of its window closing, with ~5 days of slack
# before the evidence is pruned — four passes a day, no provider calls, and
# far less frequent than the 5-minute MarketOps cycle it must not crowd.
# The pass is a clean no-op while enable_crypto_tape_reconciler is off, so the
# timer is safe to install dark and enable later.

[Unit]
Description=Run Probability Arena crypto survival reconciliation every 6 hours

[Timer]
# NEW-LOW fix (third Lane-B review, SQLite coexistence): was `:20:00`,
# which sits directly on the 5-minute MarketOps grid (OnUnitActiveSec=5min
# from an OnBootSec=2min anchor lands on :02, :07, :12, :17, :22, ... on
# many boot alignments, and separately can land on :20 exactly depending on
# boot time) — an odd, non-multiple-of-5 offset avoids sitting on that grid
# at all, on any boot alignment.
OnCalendar=*-*-* 03,09,15,21:07:00
RandomizedDelaySec=300
# Persistent=false deliberately: a missed pass is harmless (the window carries
# 12h of slack past the 36h closing edge, and state-driven backlog selection
# recovers anything older), whereas a catch-up firing lands in the boot storm
# alongside marketops OnBootSec=2min, meme-news 3min and tick-aggregation 5min,
# with the watcher already writing. The pass now holds its write lock only
# per-batch (a small fraction of a second at a time, not the whole pass) —
# but a competing writer's worst-case WAIT still tracks this pass's WALL TIME
# (up to ~20s plus one batch, measured; see NEW-H2 in crypto_tape.py), not
# that per-batch hold, so landing this writer in the boot-storm window is
# still worth avoiding — which is the point of deferring a missed pass to the
# next scheduled tick instead of catching up immediately.
Persistent=false
Unit=probability-arena-crypto-reconcile.service

[Install]
WantedBy=timers.target
